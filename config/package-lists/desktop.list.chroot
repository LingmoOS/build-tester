# Live session
#
# live-config is pulled in by live-build itself, but the packages its
# components need are only Recommends, and build.sh runs apt with
# --apt-recommends false. Missing them fails silently: 0030-user-setup
# exits early when user-setup is absent, so the live system boots with no
# account at all and lingmo-dm has nobody to log in.
live-tools
user-setup
sudo
locales
keyboard-configuration
console-setup

# Desktop
lingmo-shell-meta

# Base
bash-completion
nano

# Network
iw
wireless-regdb
wpasupplicant

# Audio
pipewire-audio

# Authorization
pkexec

# Input method
fcitx5
fcitx5-frontend-all
fcitx5-config-qt
im-config

# Fonts
fonts-noto-core
fonts-noto-cjk
fonts-noto-mono
fonts-noto-color-emoji

# Utility
chromium
fastfetch

# Installer, with the boot loader programs it puts on the disk
lingmo-installer-config
lingmo-installer
lingmo-plymouth
efibootmgr
grub-efi-amd64-bin
grub-efi-amd64-signed
grub-pc-bin
shim-signed
